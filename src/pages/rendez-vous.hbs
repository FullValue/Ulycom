<main data-theme="invert" data-barba-namespace="form" data-barba="container" class="main-wrapper"><div data-preload-move="" class="main-content"><section class="section cc-space"><div data-max="" data-pt="" data-pb="s" data-ph="" class="main-container z-1"><div id="bloc-section" class="offer__content"><div id="my-cal-inline" class="embed_el">{{> booking}}</div><div class="offer_content__bottom"><div style="opacity: 0.5;" class="section_divider"><canvas style="position: absolute; inset: 0; width: 100%; height: 100%; opacity: 1;" data-dot-canvas="" data-dot-color="#0171e3" data-appear-animation="false" class="canvas"></canvas></div><div class="logo_marquee" data-logo-marquee="" role="region" aria-label="Nos clients"><div class="logo_marquee__track"><div class="logo_marquee__set" role="list">{{#each @root.clients}}<div class="logo_marquee__item" role="listitem"><img src="{{logo}}" alt="{{name}}" loading="lazy" class="logo_marquee__img"/></div>{{/each}}</div><div class="logo_marquee__set" aria-hidden="true">{{#each @root.clients}}<div class="logo_marquee__item" aria-hidden="true"><img src="{{logo}}" alt="" loading="lazy" class="logo_marquee__img"/></div>{{/each}}</div></div></div><div style="opacity: 0.5;" class="section_divider"><canvas style="position: absolute; inset: 0; width: 100%; height: 100%; opacity: 1;" data-dot-canvas="" data-dot-color="#0171e3" data-appear-animation="false" class="canvas"></canvas></div><div data-cycle="group" class="hero_review__group">{{#each @root.reviews}}<div data-cycle="item" class="hero_review__item"><div style="max-width: 28ch;" class="p_wrap text-center text-s mx-auto"><p data-split="words" data-split-mask="false" data-split-index="true" class="">{{quote}}</p></div><div class="hero_review__bottom"><div class="flex-row gap-8"><div data-cycle="translate" style="--index:1;" data-w-prevent="" class="hero_review__avatar"><img src="{{avatar}}" loading="lazy" alt=""/></div><div style="--index:2;" data-cycle="translate" data-w-prevent="" class="text-s weight-500">{{name}}</div></div><div data-cycle="translate" style="--index:3;" data-w-prevent="" class="hero_review__sep"></div><div class="hero_review__stars"><div data-cycle="translate" style="--index: 4;" data-w-prevent="" class="hero_review__star"><img src="/assets/img/star.svg" loading="lazy" alt="" class="hero_review_star__img"/></div><div data-cycle="translate" style="--index: 5;" data-w-prevent="" class="hero_review__star"><img src="/assets/img/star.svg" loading="lazy" alt="" class="hero_review_star__img"/></div><div data-cycle="translate" style="--index: 6;" data-w-prevent="" class="hero_review__star"><img src="/assets/img/star.svg" loading="lazy" alt="" class="hero_review_star__img"/></div><div data-cycle="translate" style="--index: 7;" data-w-prevent="" class="hero_review__star"><img src="/assets/img/star.svg" loading="lazy" alt="" class="hero_review_star__img"/></div><div data-cycle="translate" style="--index: 8;" data-w-prevent="" class="hero_review__star"><img src="/assets/img/star.svg" loading="lazy" alt="" class="hero_review_star__img"/></div></div></div></div>{{/each}}</div></div></div></div></section>{{> footer}}</div>{{> whatsapp}}</main>