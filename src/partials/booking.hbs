{{#unless site.calLink}}<div class="bk" data-booking="" data-step="date"><script type="application/json" data-bk-config="">{{{site.bookingJson}}}</script><div class="bk_head"><span class="bk_tag font-mono">{{site.booking.tag}}</span><h1 class="bk_title">{{site.booking.heading}}</h1><p class="bk_lead">{{site.booking.lead}}</p></div><div class="bk_card"><aside class="bk_info"><div class="bk_host"><span class="bk_host_icon is-bare">{{> ulylogo}}</span><span>{{site.name}}</span></div><h2 class="bk_event">{{site.booking.title}}</h2><ul class="bk_meta"><li><svg class="bk_ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>{{site.booking.duration}} min</li><li><svg class="bk_ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m16 13 5.223 3.482a.5.5 0 0 0 .777-.416V7.87a.5.5 0 0 0-.752-.432L16 10.5"/><rect x="2" y="6" width="14" height="12" rx="2"/></svg>{{site.booking.location}}</li><li><svg class="bk_ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20M2 12h20"/></svg>{{site.booking.timezoneLabel}}</li></ul><p class="bk_desc">{{site.booking.description}}</p><div class="bk_pick" data-bk-summary="" hidden><svg class="bk_ico" viewBox="0 0 24 24" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg><div><p class="bk_pick_date" data-bk-summary-date=""></p><p class="bk_pick_time" data-bk-summary-time=""></p></div></div></aside><div class="bk_stage"><section class="bk_step bk_step_date" data-bk-panel="date" aria-label="Choix de la date et de l’horaire"><div class="bk_cal"><div class="bk_cal_head"><button type="button" class="bk_icon_btn" data-bk-prev="" aria-label="Mois précédent"><svg class="bk_ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button><p class="bk_cal_caption" data-bk-month="" aria-live="polite"></p><button type="button" class="bk_icon_btn" data-bk-next="" aria-label="Mois suivant"><svg class="bk_ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button></div><div class="bk_cal_week" aria-hidden="true"><span>lu</span><span>ma</span><span>me</span><span>je</span><span>ve</span><span>sa</span><span>di</span></div><div class="bk_cal_grid" role="grid" data-bk-grid=""></div></div><div class="bk_slots"><p class="bk_slots_day" data-bk-day="" aria-live="polite">Choisissez une date</p><div class="bk_slots_list" data-bk-slots="" role="list"></div></div></section><section class="bk_step bk_step_form" data-bk-panel="form" aria-label="Vos coordonnées" hidden><button type="button" class="bk_back" data-bk-back=""><svg class="bk_ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 19-7-7 7-7M19 12H5"/></svg>Changer de créneau</button><form class="bk_form" data-bk-form="" novalidate=""><div class="bk_row"><div class="bk_field"><label class="bk_label" for="bk-name">Nom et prénom <span class="bk_req">*</span></label><input class="bk_input" id="bk-name" name="nom" autocomplete="name" required="" placeholder="Camille Martin"/><p class="bk_err" data-bk-err="nom"></p></div><div class="bk_field"><label class="bk_label" for="bk-email">E-mail <span class="bk_req">*</span></label><input class="bk_input" id="bk-email" name="email" type="email" autocomplete="email" required="" placeholder="camille@entreprise.fr"/><p class="bk_err" data-bk-err="email"></p></div></div><div class="bk_row"><div class="bk_field"><label class="bk_label" for="bk-tel">Téléphone</label><input class="bk_input" id="bk-tel" name="telephone" type="tel" autocomplete="tel" placeholder="06 12 34 56 78"/></div><div class="bk_field"><label class="bk_label" for="bk-company">Entreprise</label><input class="bk_input" id="bk-company" name="entreprise" autocomplete="organization" placeholder="Nom de votre société"/></div></div><fieldset class="bk_field bk_fieldset"><legend class="bk_label">Type de projet</legend><div class="bk_chips">{{#each site.booking.projectTypes}}<label class="bk_chip"><input type="radio" name="projet" value="{{this}}"/><span>{{this}}</span></label>{{/each}}</div></fieldset><div class="bk_field"><label class="bk_label" for="bk-budget">Budget envisagé</label><div class="bk_select"><select class="bk_input" id="bk-budget" name="budget"><option value="">Sélectionner…</option>{{#each site.booking.budgets}}<option>{{this}}</option>{{/each}}</select><svg class="bk_ico" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></div></div><div class="bk_field"><label class="bk_label" for="bk-msg">Votre projet en quelques lignes</label><textarea class="bk_input bk_textarea" id="bk-msg" name="message" rows="4" placeholder="Objectifs, existant, délais, inspirations…"></textarea></div><div class="bk_hp" aria-hidden="true"><label for="bk-website">Site web</label><input id="bk-website" name="website" tabindex="-1" autocomplete="off"/></div><p class="bk_form_error" data-bk-error="" role="alert" hidden></p><div class="bk_actions"><button type="submit" data-stagger-char="true" data-wf--interactive-button--settings-variant="main" class="btn_wrap bk_submit" data-bk-submit=""><div class="btn_inner"><div class="btn_text"><span data-stagger-char="text" class="btn_text_span" data-bk-submit-label="">Confirmer le rendez-vous</span></div><div class="btn_icon cc-arrow-up"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="btn_icon__svg cc-arrow"><path d="M6 18L18 6M18 6H10M18 6V14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="btn_icon__svg cc-arrow"><path d="M6 18L18 6M18 6H10M18 6V14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></div></div><div class="btn_bg"><div class="btn_border"><div data-btn="border-animate" class="btn_border__bg"></div></div></div></button><p class="bk_note">Vos informations servent uniquement à préparer l’appel.</p></div></form></section><section class="bk_step bk_step_done" data-bk-panel="done" aria-label="Confirmation" hidden><div class="bk_done_icon"><svg viewBox="0 0 52 52" aria-hidden="true"><circle class="bk_done_circle" cx="26" cy="26" r="24"/><path class="bk_done_check" d="M15 27l7 7 15-15"/></svg></div><h3 class="bk_done_title" data-bk-done-title="" tabindex="-1">C’est noté !</h3><p class="bk_done_text" data-bk-done-text=""></p><div class="bk_done_slot"><svg class="bk_ico" viewBox="0 0 24 24" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg><div><p class="bk_pick_date" data-bk-done-date=""></p><p class="bk_pick_time" data-bk-done-time=""></p></div></div><div class="bk_done_actions"><a class="btn_wrap w-inline-block" data-wf--interactive-button--settings-variant="base-outline" data-bk-gcal="" href="#" target="_blank" rel="noopener" data-barba-prevent="true"><div class="btn_inner"><div class="btn_text"><span class="btn_text_span">Ajouter à Google Agenda</span></div></div><div class="btn_bg"></div></a><a class="btn_wrap w-inline-block" data-wf--interactive-button--settings-variant="base-outline" data-bk-ics="" href="#" download="ulycom-appel.ics" data-barba-prevent="true"><div class="btn_inner"><div class="btn_text"><span class="btn_text_span">Télécharger (.ics)</span></div></div><div class="btn_bg"></div></a></div><button type="button" class="bk_back bk_restart" data-bk-restart="">Réserver un autre créneau</button></section></div></div></div>{{/unless}}
