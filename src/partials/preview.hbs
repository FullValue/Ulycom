<div class="lp" data-live-preview="" data-mode="{{#if project.previewLive}}live{{else}}shots{{/if}}" data-url="{{project.url}}" data-device="desktop"><div class="lp_bar"><div class="lp_dots" aria-hidden="true"><span></span><span></span><span></span></div><div class="lp_url"><svg class="lp_ico" viewBox="0 0 24 24" aria-hidden="true"><rect width="14" height="10" x="5" y="11" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg><span class="lp_url_text">{{project.cleanUrl}}</span>{{#if project.previewLive}}<span class="lp_live"><span class="lp_live_dot"></span>En direct</span>{{/if}}</div><div class="lp_tabs" role="tablist" aria-label="Format d’aperçu"><span class="lp_tabs_bg" aria-hidden="true"></span><button type="button" role="tab" class="lp_tab" data-lp-tab="desktop" aria-selected="true"><svg class="lp_ico" viewBox="0 0 24 24" aria-hidden="true"><rect width="20" height="14" x="2" y="3" rx="2"/><path d="M8 21h8M12 17v4"/></svg><span>Desktop</span></button><button type="button" role="tab" class="lp_tab" data-lp-tab="mobile" aria-selected="false"><svg class="lp_ico" viewBox="0 0 24 24" aria-hidden="true"><rect width="14" height="20" x="5" y="2" rx="2"/><path d="M12 18h.01"/></svg><span>Mobile</span></button></div><a class="lp_open" href="{{project.url}}" target="_blank" rel="noopener" data-barba-prevent="true"><span>Ouvrir le site</span><svg class="lp_ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg></a></div><div class="lp_stage"><div class="lp_pane lp_pane_desktop" data-lp-pane="desktop">{{#if project.previewLive}}<div class="lp_frame" data-lp-frame="1440"><iframe title="Aperçu du site {{project.name}} (ordinateur)" data-src="{{project.url}}" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe><div class="lp_loading"><span></span>Chargement du site…</div></div>{{else}}<div class="lp_scroll" data-lenis-prevent="" tabindex="0" aria-label="Capture complète du site {{project.name}}, faites défiler">{{#each project.previewDesktop}}<img src="{{src}}" width="{{w}}" height="{{h}}" alt="" loading="lazy" decoding="async"/>{{/each}}</div>{{/if}}<div class="lp_hint" aria-hidden="true"><svg class="lp_ico" viewBox="0 0 24 24"><rect width="12" height="18" x="6" y="3" rx="6"/><path d="M12 7v4"/></svg>Faites défiler le site</div></div><div class="lp_pane lp_pane_mobile" data-lp-pane="mobile" hidden><div class="lp_phone"><span class="lp_island" aria-hidden="true"></span>{{#if project.previewLive}}<div class="lp_frame" data-lp-frame="390"><iframe title="Aperçu du site {{project.name}} (mobile)" data-src="{{project.url}}" loading="lazy"></iframe><div class="lp_loading"><span></span>Chargement…</div></div>{{else}}<div class="lp_scroll" data-lenis-prevent="" tabindex="0" aria-label="Capture complète du site {{project.name}} sur mobile, faites défiler">{{#each project.previewMobile}}<img src="{{src}}" width="{{w}}" height="{{h}}" alt="" loading="lazy" decoding="async"/>{{/each}}</div>{{/if}}</div></div></div></div>
