<footer data-footer-reveal="" class="footer_flux"><div aria-hidden="true" class="footer_flux__ascii cc-left"><canvas data-ascii-hand="left"></canvas></div><div aria-hidden="true" class="footer_flux__ascii cc-right"><canvas data-ascii-hand="right"></canvas></div><div class="footer_flux__inner"><div class="footer_flux__grid"><div class="footer_flux__col cc-left"><p class="footer_flux__lead">{{site.footer.lead}}</p><p class="footer_flux__muted">{{site.footer.text}}</p><div class="button-group"><a target="_self" data-modal-trigger="false" data-stagger-char="true" data-wf--interactive-button--settings-variant="main" href="/rendez-vous" class="btn_wrap w-inline-block"><div class="btn_inner"><div class="btn_text"><span data-stagger-char="text" class="btn_text_span">{{site.cta.button}}</span></div><div class="btn_icon cc-arrow-up"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="btn_icon__svg cc-arrow"><path d="M6 18L18 6M18 6H10M18 6V14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="btn_icon__svg cc-arrow"><path d="M6 18L18 6M18 6H10M18 6V14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></div></div><div class="btn_bg"><div class="btn_border"><div data-btn="border-animate" class="btn_border__bg"></div></div></div></a></div><div class="footer_flux__status">{{#each site.footer.status}}<p class="footer_flux__status-row"><span class="footer_flux__pulse"></span><span>{{this}}</span></p>{{/each}}</div></div><nav aria-label="Pied de page" class="footer_flux__col cc-center"><ul class="footer_flux__nav"><li><a href="/" data-stagger-char="true" class="footer_flux__link"><span data-stagger-char="text">Accueil</span></a></li><li><a href="/realisations" data-stagger-char="true" class="footer_flux__link"><span data-stagger-char="text">Réalisations</span></a></li><li><a href="/offre" data-stagger-char="true" class="footer_flux__link"><span data-stagger-char="text">Offre</span></a></li><li><a href="/rendez-vous" data-stagger-char="true" class="footer_flux__link"><span data-stagger-char="text">Contact</span></a></li>{{#if site.partner.url}}<li><a href="{{site.partner.url}}" target="_blank" rel="noopener" data-barba-prevent="true" data-stagger-char="true" class="footer_flux__link"><span data-stagger-char="text">Partenaire IA</span></a></li>{{/if}}</ul></nav><div class="footer_flux__col cc-right"><div class="footer_flux__links">{{#if site.email}}<a href="mailto:{{site.email}}" data-barba-prevent="true" class="footer_flux__underline">{{site.email}}</a>{{/if}}{{#if site.whatsappExternal}}<a href="{{site.whatsappUrl}}" target="_blank" rel="noopener" data-barba-prevent="true" class="footer_flux__underline">WhatsApp</a>{{/if}}<a href="/rendez-vous" class="footer_flux__underline">Réserver un appel</a></div><div class="footer_flux__links">{{#if site.partner.url}}<a href="{{site.partner.url}}" target="_blank" rel="noopener" data-barba-prevent="true" class="footer_flux__underline">IA en partenariat avec {{site.partner.name}}</a>{{/if}}<a href="/legal/mentions-legales" class="footer_flux__underline">Mentions légales</a></div><div class="footer_flux__keys"><button type="button" data-footer-top="" class="footer_flux__key"><kbd>↑</kbd><span>haut de page</span></button></div></div></div><div class="footer_flux__copy"><span>© <span data-current-year="">{{year}}</span></span><span>{{site.name}}. Tous droits réservés.</span><span>{{site.footer.tagline}}</span></div><div class="footer_flux__word"><div aria-hidden="true" data-footer-word="" class="footer_flux__word-inner">{{#each site.footer.letters}}<span>{{this}}</span>{{/each}}</div><span class="sr-only">{{site.name}}</span></div></div></footer>