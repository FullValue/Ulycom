function translateDates() {
  document.querySelectorAll('.cms-date:not([data-translated])').forEach(function (el) {
    const rawText = el.textContent.trim();
    if (!rawText) return;
    const parsedDate = new Date(rawText);
    if (isNaN(parsedDate.getTime())) return;
    el.textContent = new Intl.DateTimeFormat('fr-FR', {
      year: 'numeric',
      month: 'long',
    }).format(parsedDate);
    el.dataset.translated = 'true';
  });
}

// Initial
translateDates();

// Re-run à chaque changement du DOM (couvre Barba, AJAX, tout)
new MutationObserver(translateDates).observe(document.body, {
  childList: true,
  subtree: true,
});
</script></div></div></div>